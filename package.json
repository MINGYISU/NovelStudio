{
  "name": "novelstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal, local-first novel writing app.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "NODE_ENV=development NOVEL_DATA_DIR=./.data-dev PORT=4318 tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:dev": "NODE_ENV=development NOVEL_DATA_DIR=./.data-dev tsx src/server/scripts/seed-dev.ts",
    "backup:cold": "tsx src/server/scripts/cold-backup.ts",
    "restore:cold": "tsx src/server/scripts/restore-cold.ts",
    "verify:cold": "tsx src/server/scripts/verify-cold.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.104.5",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-arborist": "4.0.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
