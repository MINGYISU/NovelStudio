# Copy to .env only if you need to override defaults. .env is git-ignored.

# Where the live database, images and automatic (hot) backups are stored.
#   npm start    -> ~/Library/Application Support/NovelStudio   (real writing)
#   npm run dev  -> ./.data-dev                                  (sample data)
#   tests        -> a fresh temp directory per test file
# Dev mode refuses to start if this points at the real data directory.
# NOVEL_DATA_DIR=

# Port for npm start. The server always binds to 127.0.0.1 (not configurable).
# PORT=4317

# The cold backup folder is set inside the app (Settings > Cold backup) and
# stored in <data dir>/config.json, so it survives a damaged database.
